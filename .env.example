CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HOST=127.0.0.1
PORT=8788
DATABASE_PATH=./data/billing.sqlite
# Prefer generating an MCP token on the Settings page, then clicking Save settings to activate it.
# Optional fallback for deployments without saved MCP settings. UI settings override it.
# Use a separate secret with at least 32 visible ASCII characters, without whitespace.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=
# Optional: comma-separated exact HTTP(S) origins, without paths or wildcards.
# Empty rejects requests with Origin; agents that omit Origin can still connect.
MCP_ALLOWED_ORIGINS=
# Notification variables below supply initial defaults. Settings saved in the UI override them.
# Optional: Feishu group custom bot. Leave empty to disable Feishu notifications.
FEISHU_WEBHOOK_URL=
# Fill this only if signature verification is enabled for the bot.
FEISHU_SIGNING_SECRET=
# Optional: independent budget webhook. Set both values to enable; leave both empty to disable.
BUDGET_WEBHOOK_URL=
# Positive integer US cents: 30000 = USD 300. Strictly greater triggers once per billing cycle.
BUDGET_THRESHOLD_CENTS=
